index 0000000..eb7dfc0
--- /dev/null
+++ b/dashboard/tools/datalog/store_agent.php
@@ -0,0 +1,209 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * Datalog: the downtown store agent (the Home Assistant add-on that prints
+ * pickup orders), reached the same way the print queue reaches it —
+ * curbside_agent_request() in orders/curbsidePrint.php: Cloudflare Access
+ * service token plus the HMAC signature, CURBSIDE_AGENT_* from the API Cred
+ * page. A narrow window onto the agent's typed-request API, not a proxy:
+ * only these routes, only these request types.
+ *
+ *   GET  ?action=status                    the agent's /status (printer, queue)
+ *   GET  ?action=capabilities              handlers, payload rules, limits
+ *   GET  ?action=targets[&revel=1]         configured registers; &revel=1 adds
+ *                                          Revel's own PosStation record for
+ *                                          each (one Revel call, cached 5 min;
+ *                                          Revel's IP is what the station last
+ *                                          reported, not a live check)
+ *   GET  ?action=diagnostics               cached, read-only agent diagnostics
+ *   GET  ?action=request&request_id=…      one request's durable state
+ *   POST {"action":"submit","request":{…}} submit diagnostic.echo,
+ *                                          diagnostic.probe or revel.caller_id;
+ *                                          "dry_run" must be an explicit boolean
+ *
+ * GET never changes anything and never reaches a register or the printer.
+ * Printing is not here: it keeps orders/curbsidePrint.php.
+ *
+ * Every answer is {"ok", "action", "http" (the agent's status, 0 when it was
+ * never reached), "reached" ("agent" | "cloudflare" | "tunnel" | "none"),
+ * "agent" (the agent's JSON, as it sent it), "error"}. "ok" is true only for
+ * a 2xx from the agent itself. The HTTP status of this endpoint mirrors the
+ * agent's when the agent answered, and is 502 when it did not, so a refusal
+ * by the agent (409, 410, 422, 429) reads differently from a broken tunnel
+ * or a rejected service token.
+ *
+ * Nothing here retries a submit. A submit whose answer was lost is repeated
+ * by the caller with the SAME request_id, which the agent answers from its
+ * record without running it again.
+ */
+
+const DATALOG_METHODS = ['GET', 'POST'];
+require_once __DIR__ . '/datalogAuth.php';
+require_once dirname(__DIR__) . '/functions.php';
+require_once dirname(__DIR__) . '/orders/curbsidePrint.php';
+
+/** @var PDO $pdo — from auth.php via datalogAuth.php */
+$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+header('Cache-Control: no-store');
+
+const STORE_AGENT_TYPES       = ['diagnostic.echo', 'diagnostic.probe', 'revel.caller_id'];
+const STORE_AGENT_MAX_BODY    = 8192;
+const STORE_AGENT_MAX_REPLY   = 262144;
+const STORE_AGENT_ID_RE       = '/^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$/';
+const STORE_AGENT_PER_MINUTE  = ['GET' => 60, 'POST' => 20];
+
+/**
+ * A fixed one-minute window in auth_rate_limit, shared by every caller of
+ * this endpoint (they all hold the one datalog bearer). Fails open on a
+ * database error: the agent has its own per-handler limits behind this.
+ */
+$storeAgentRate = static function (PDO $pdo, string $method): bool {
+    $window = intdiv(time(), 60) * 60;
+    try {
+        $pdo->prepare(
+            'INSERT INTO auth_rate_limit (scope, key_hash, window_start, count, last_seen) VALUES (?, ?, ?, 1, ?)
+             ON DUPLICATE KEY UPDATE count = IF(window_start = VALUES(window_start), count + 1, 1),
+                                     window_start = VALUES(window_start), last_seen = VALUES(last_seen)'
+        )->execute(['store_agent', hash('sha256', $method), $window, time()]);
+        $q = $pdo->prepare('SELECT count FROM auth_rate_limit WHERE scope = ? AND key_hash = ?');
+        $q->execute(['store_agent', hash('sha256', $method)]);
+        return (int) $q->fetchColumn() <= STORE_AGENT_PER_MINUTE[$method];
+    } catch (\Throwable $e) {
+        error_log('store_agent: rate limit unavailable: ' . $e->getMessage());
+        return true;
+    }
+};
+
+/**
+ * Answer with what the agent said. "reached" separates an agent answer
+ * (its JSON carries agent_api, or it is /status) from Cloudflare refusing
+ * the service token (403 without agent JSON) and a dead tunnel or add-on.
+ */
+$storeAgentReply = static function (string $action, array $r, bool $isStatus = false): never {
+    $json = is_array($r['json']) ? $r['json'] : null;
+    $byAgent = $json !== null && (array_key_exists('agent_api', $json) || ($isStatus && isset($json['version'])))
+        || ($r['http'] === 401 && $json !== null && ($json['error'] ?? null) === 'unauthorized');
+    if ($byAgent) {
+        $reached = 'agent';
+    } elseif ($r['http'] === 403) {
+        $reached = 'cloudflare';
+    } elseif ($r['http'] > 0) {
+        $reached = 'tunnel';
+    } else {
+        $reached = 'none';
+    }
+    $ok = $reached === 'agent' && $r['http'] >= 200 && $r['http'] < 300;
+    $error = $ok ? null : ($reached === 'agent'
+        ? (is_array($json['error'] ?? null) ? ($json['error']['code'] ?? 'agent_error')
+            : ($r['http'] === 401 ? 'agent_refused_signature' : 'agent_error'))
+        : ($reached === 'cloudflare' ? 'cloudflare_access_refused'
+            : ($reached === 'tunnel' ? 'tunnel_or_addon_down: ' . (string) $r['error'] : 'not_reached: ' . (string) $r['error'])));
+    http_response_code($reached === 'agent' ? $r['http'] : 502);
+    header('Content-Type: application/json; charset=utf-8');
+    $body = json_encode([
+        'ok' => $ok, 'action' => $action, 'http' => $r['http'], 'reached' => $reached,
+        'agent' => $reached === 'agent' ? $json : null, 'error' => $error,
+    ], JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
+    if (strlen((string) $body) > STORE_AGENT_MAX_REPLY) {
+        http_response_code(502);
+        $body = json_encode(['ok' => false, 'action' => $action, 'http' => $r['http'], 'reached' => $reached,
+                             'agent' => null, 'error' => 'agent reply too large']);
+    }
+    echo $body;
+    exit;
+};
+
+if (curbside_agent_config() === null) {
+    datalog_fail(503, 'the store agent is not set up (CURBSIDE_AGENT_* on the API Cred page)');
+}
+$method = (string) ($_SERVER['REQUEST_METHOD'] ?? 'GET');
+if (!$storeAgentRate($pdo, $method)) {
+    datalog_fail(429, 'at most ' . STORE_AGENT_PER_MINUTE[$method] . " $method requests a minute");
+}
+
+if ($method === 'POST') {
+    $raw = (string) file_get_contents('php://input', false, null, 0, STORE_AGENT_MAX_BODY + 1);
+    if (strlen($raw) > STORE_AGENT_MAX_BODY) datalog_fail(413, 'body over ' . STORE_AGENT_MAX_BODY . ' bytes');
+    $in = json_decode($raw, true);
+    if (!is_array($in) || array_keys($in) !== ['action', 'request'] && array_keys($in) !== ['request', 'action']) {
+        datalog_fail(400, 'body must be exactly {"action":"submit","request":{...}}');
+    }
+    if ($in['action'] !== 'submit') datalog_fail(400, 'action must be submit');
+    $req = $in['request'];
+    if (!is_array($req) || array_is_list($req)) datalog_fail(400, 'request must be an object');
+    if (!in_array($req['type'] ?? null, STORE_AGENT_TYPES, true)) {
+        datalog_fail(400, 'type must be one of: ' . implode(', ', STORE_AGENT_TYPES));
+    }
+    if (!array_key_exists('dry_run', $req) || !is_bool($req['dry_run'])) {
+        datalog_fail(400, 'dry_run must be true or false, explicitly');
+    }
+    if (!is_string($req['request_id'] ?? null) || !preg_match(STORE_AGENT_ID_RE, $req['request_id'])) {
+        datalog_fail(400, 'request_id: 8-128 characters of A-Z a-z 0-9 . _ : - starting with a letter or digit');
+    }
+    if (!is_string($req['target'] ?? null) || !preg_match('/^[a-z0-9][a-z0-9-]{0,31}$/', $req['target'])) {
+        datalog_fail(400, 'target must be a configured target id (see action=targets)');
+    }
+    // Everything else (version, expiry, payload rules, which targets exist
+    // and may go live) is the agent's to judge; it answers 422 with a code.
+    $body = json_encode($req, JSON_UNESCAPED_SLASHES);
+    if ($body === false) datalog_fail(400, 'request is not encodable');
+    // Logged: id, type, target, mode. Never the payload (a name and number).
+    error_log(sprintf('store_agent: submit %s type=%s target=%s dry_run=%s',
+        $req['request_id'], $req['type'], $req['target'], $req['dry_run'] ? 'true' : 'false'));
+    $storeAgentReply('submit', curbside_agent_request('POST', '/v1/requests', $body));
+}
+
+$action = (string) ($_GET['action'] ?? '');
+switch ($action) {
+    case 'status':
+        $storeAgentReply('status', curbside_agent_request('GET', '/status'), true);
+    case 'capabilities':
+        $storeAgentReply('capabilities', curbside_agent_request('GET', '/v1/capabilities'));
+    case 'diagnostics':
+        $storeAgentReply('diagnostics', curbside_agent_request('GET', '/v1/diagnostics'));
+    case 'request':
+        $id = (string) ($_GET['request_id'] ?? '');
+        if (!preg_match(STORE_AGENT_ID_RE, $id)) datalog_fail(400, 'request_id is not a valid id');
+        // The id's alphabet needs no escaping, so the signed path is the sent path.
+        $storeAgentReply('request', curbside_agent_request('GET', '/v1/requests/' . $id));
+    case 'targets':
+        $r = curbside_agent_request('GET', '/v1/targets');
+        if (!empty($_GET['revel']) && is_array($r['json']) && isset($r['json']['targets'])) {
+            $r['json']['revel_stations'] = store_agent_revel_stations($pdo);
+        }
+        $storeAgentReply('targets', $r);
+    default:
+        datalog_fail(400, 'action must be status, capabilities, targets, diagnostics or request '
+            . '(GET), or POST {"action":"submit","request":{...}}');
+}
+
+/**
+ * Revel's records of the downtown stations: what each register last told
+ * Revel (name, IP, caller-ID setting, last use). Recorded data, not a
+ * connectivity check. One Revel call per five minutes at most.
+ */
+function store_agent_revel_stations(PDO $pdo): array {
+    require_once dirname(__DIR__) . '/home/chartLib.php';
+    require_once dirname(__DIR__) . '/revel/revelApiClient.php';
+    $cached = home_chart_cache_read($pdo, 'store_agent_revel_stations', 300);
+    if ($cached !== null) return $cached + ['cached' => true];
+    try {
+        $r = revelApiCall('PosStation', ['establishment' => 1, 'limit' => 50,
+            'fields' => 'id,name,active,ip_address,caller_id,pos_last_accessed,model_num,updated_date']);
+    } catch (\Throwable $e) {
+        return ['source' => 'revel_api', 'error' => 'Revel call failed'];
+    }
+    if (!$r['ok']) return ['source' => 'revel_api', 'error' => 'Revel answered ' . (string) ($r['status'] ?? '?')];
+    $out = ['source' => 'revel_api (recorded, not live)', 'fetched_at' => gmdate('Y-m-d\TH:i:s\Z'), 'stations' => []];
+    foreach ($r['data']['objects'] ?? [] as $s) {
+        $out['stations'][] = [
+            'revel_station' => (int) ($s['id'] ?? 0), 'name' => (string) ($s['name'] ?? ''),
+            'active' => (bool) ($s['active'] ?? false), 'ip_address' => $s['ip_address'] ?? null,
+            'caller_id' => (bool) ($s['caller_id'] ?? false), 'model' => $s['model_num'] ?? null,
+            'last_accessed' => $s['pos_last_accessed'] ?? null,  // Revel's timestamp, as Revel gives it
+        ];
+    }
+    home_chart_cache_write($pdo, 'store_agent_revel_stations', $out);
+    return $out + ['cached' => false];
+}
diff --git a/docs/store-agent-test.py b/docs/store-agent-test.py
new file mode 100644
index 0000000..c5f2080
--- /dev/null
+++ b/docs/store-agent-test.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+"""Remote acceptance test for the downtown store agent, through Datalog.
+
+Talks only to https://dashboard.nmteaco.com/tools/datalog/store_agent.php
+with the bearer in $DATALOG_API_TOKEN (read from the environment, never
+printed). Standard library only. Every request id and expiry is made fresh
+when it runs.
+
+    python3 docs/store-agent-test.py                          # safe checks only
+    python3 docs/store-agent-test.py --live --target pink-ipad  # + ONE visible caller-ID test
+
+The default run sends nothing to any register and prints nothing: it reads
+status/capabilities/targets/diagnostics, round-trips a diagnostic.echo
+challenge, checks the exact-repeat and 409 rules, checks rejections, and runs
+a caller-ID dry run. --live adds one live caller-ID record to the named
+register (only a register marked test, with the test identity, while the
+agent is in mode "test"), polls it to a terminal state, and repeats it to
+show nothing more is sent. It never picks a register for you.
+
+A live send that went out is reported "sent": the network took the bytes.
+Whether the iPad showed the call, sounded, or let staff dismiss it can only be
+seen at the iPad; this script reports those as unconfirmed. If a pop-up
+appears, dismiss it with Hang up, not Answer (Answer opens a customer/order).
+"""
+
+import argparse
+import datetime
+import json
+import os
+import secrets
+import sys
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+URL = os.environ.get("STORE_AGENT_DATALOG_URL", "https://dashboard.nmteaco.com/tools/datalog/store_agent.php")
+TEST_NAME = "TEST CURBSIDE"
+
+
+def token():
+    t = os.environ.get("DATALOG_API_TOKEN", "")
+    if len(t) < 32:
+        sys.exit("DATALOG_API_TOKEN is not set in the environment")
+    return t
+
+
+def http(method, query=None, body=None):
+    url = URL + ("?" + urllib.parse.urlencode(query) if query else "")
+    data = json.dumps(body, separators=(",", ":")).encode() if body is not None else None
+    req = urllib.request.Request(url, data=data, method=method, headers={
+        "Authorization": f"Bearer {token()}", "Content-Type": "application/json", "Accept": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=30) as r:
+            return r.status, json.loads(r.read() or b"null")
+    except urllib.error.HTTPError as e:
+        raw = e.read()
+        try:
+            return e.code, json.loads(raw or b"null")
+        except ValueError:
+            return e.code, {"ok": False, "error": f"non-JSON answer ({len(raw)} bytes)"}
+
+
+def expires(seconds):
+    return (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=seconds)).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+class Run:
+    def __init__(self):
+        self.run = "dash:" + datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S") + ":" + secrets.token_hex(3)
+        self.results = []
+        self.n = 0
+
+    def rid(self, what):
+        self.n += 1
+        return f"{self.run}:{what}:{self.n}"
+
+    def check(self, name, ok, detail=""):
+        self.results.append((name, bool(ok), detail))
+        print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  — {detail}" if detail else ""), flush=True)
+        return ok
+
+    def submit(self, envelope):
+        return http("POST", body={"action": "submit", "request": envelope})
+
+    def poll(self, request_id, timeout=30):
+        end = time.time() + timeout
+        while True:
+            code, b = http("GET", {"action": "request", "request_id": request_id})
+            agent = b.get("agent") or {}
+            if agent.get("terminal") or time.time() > end:
+                return code, b
+            time.sleep(1)
+
+    def envelope(self, type_, target, payload, dry_run, ttl=60, what=None):
+        return {"version": 1, "request_id": self.rid(what or type_.split(".")[1]), "type": type_,
+                "target": target, "dry_run": dry_run, "expires_at": expires(ttl), "payload": payload}
+
+
+def safe(r):
+    # 1. Reads.
+    for action in ("status", "capabilities", "targets", "diagnostics"):
+        code, b = http("GET", {"action": action})
+        r.check(f"read {action}", code == 200 and b.get("ok") and b.get("reached") == "agent",
+                f"HTTP {code}, reached {b.get('reached')}, error {b.get('error')}")
+        if action == "status" and b.get("agent"):
+            r.check("status keeps the print fields", all(k in b["agent"] for k in ("version", "formats", "printer", "queue"))
+                    and "pdf" in b["agent"]["formats"], f"version {b['agent'].get('version')}")
+        if action == "capabilities" and b.get("agent"):
+            r.caps = b["agent"]
+
+    # 2. Echo through the real queue.
+    challenge = "c" + secrets.token_hex(8)
+    echo = r.envelope("diagnostic.echo", "agent", {"challenge": challenge}, False)
+    code, b = r.submit(echo)
+    r.check("echo accepted", code == 202, f"HTTP {code} {b.get('error')}")
+    code, b = r.poll(echo["request_id"])
+    a = b.get("agent") or {}
+    r.check("echo returns the challenge", a.get("state") == "completed" and (a.get("result") or {}).get("challenge") == challenge,
+            f"{echo['request_id']} state {a.get('state')}")
+
+    # 3. Exact repeat: stored answer, no second run. Changed content: 409.
+    code, b = r.submit(echo)
+    a = b.get("agent") or {}
+    r.check("exact repeat answered from the record", code == 200 and a.get("duplicate") is True and a.get("attempts") == 1,
+            f"HTTP {code}, attempts {a.get('attempts')}")
+    code, b = r.submit(dict(echo, payload={"challenge": "changed-" + challenge}))
+    r.check("same id, changed content -> 409", code == 409 and b.get("error") == "request_id_conflict", f"HTTP {code}")
+
+    # 4. Rejections, none of which stores or sends anything.
+    bad = [
+        ("unknown handler", dict(r.envelope("diagnostic.echo", "agent", {"challenge": challenge}, True), type="shell.exec"), 400, None),
+        ("unknown target", r.envelope("revel.caller_id", "no-such-register", {"name": TEST_NAME, "number": "505-555-0100"}, True), 422, "invalid_target"),
+        ("name over 15 characters", r.envelope("revel.caller_id", "pink-ipad", {"name": "TEST CURBSIDE ORDER", "number": "505-555-0100"}, True), 422, "invalid_payload"),
+        ("expired", r.envelope("diagnostic.echo", "agent", {"challenge": challenge}, True, ttl=-30), 410, "expired"),
+        ("dry_run missing", {k: v for k, v in r.envelope("diagnostic.echo", "agent", {"challenge": challenge}, True).items() if k != "dry_run"}, 400, None),
+        ("unknown version", dict(r.envelope("diagnostic.echo", "agent", {"challenge": challenge}, True), version=9), 422, "unsupported_version"),
+    ]
+    for name, env, want, err in bad:
+        code, b = r.submit(env)
+        r.check(f"rejects {name}", code == want and (err is None or b.get("error") == err), f"HTTP {code} {b.get('error')}")
+        if code in (200, 202):
+            r.check(f"  ({name} must not have been accepted)", False, env["request_id"])
+
+    # 5. Caller-ID dry run against the test register.
+    test_targets = [t for h in (getattr(r, "caps", {}) or {}).get("handlers", []) if h.get("type") == "revel.caller_id"
+                    for t in h.get("test_targets", [])]
+    if not test_targets:
+        r.check("caller-ID test register configured", False, "capabilities list none")
+        return
+    target = test_targets[0]
+    dry = r.envelope("revel.caller_id", target, {"name": TEST_NAME, "number": "505-555-0100"}, True)
+    code, b = r.submit(dry)
+    r.check("caller-ID dry run accepted", code == 202, f"HTTP {code} {b.get('error')}")
+    code, b = r.poll(dry["request_id"])
+    a = b.get("agent") or {}
+    ev = a.get("evidence") or {}
+    r.check("dry run passed, nothing sent", a.get("state") == "dry_run_passed" and ev.get("outbound_sends") == 0
+            and ev.get("recipients") == 1 and ev.get("packet_bytes") == 83 and ev.get("self_check") == "ok",
+            f"{dry['request_id']}: {ev.get('recipient_scope')}, port {ev.get('destination_port')}")
+    code, b = r.submit(dict(dry, dry_run=False))
+    r.check("a dry-run id can never go live (409)", code == 409, f"HTTP {code}")
+
+
+def live(r, target):
+    env = r.envelope("revel.caller_id", target, {"name": TEST_NAME, "number": "505-555-0100"}, False, ttl=90, what="live")
+    print(f"\nLIVE: one caller-ID record to {target} ({env['request_id']})", flush=True)
+    code, b = r.submit(env)
+    if not r.check("live request accepted", code == 202, f"HTTP {code} {b.get('error')}"):
+        return
+    code, b = r.poll(env["request_id"], timeout=60)
+    a = b.get("agent") or {}
+    r.check("live request finished", a.get("terminal") is True, f"state {a.get('state')} {a.get('error')}")
+    print(json.dumps({"state": a.get("state"), "error": a.get("error"), "evidence": a.get("evidence"),
+                      "observations": a.get("observations")}, indent=1))
+    code, b = r.submit(env)
+    a2 = b.get("agent") or {}
+    r.check("repeating the live request sends nothing more", code == 200 and a2.get("duplicate") is True
+            and a2.get("attempts") == a.get("attempts"), f"HTTP {code}, attempts {a2.get('attempts')}")
+    print("\nUnconfirmed until someone at the iPad says: did an Incoming Call pop-up appear, did it sound, "
+          "and did Hang up dismiss it? (Do not press Answer.)")
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    p.add_argument("--live", action="store_true", help="also send ONE live caller-ID test record")
+    p.add_argument("--target", help="the register for --live (required with it; never chosen for you)")
+    a = p.parse_args()
+    if a.live and not a.target:
+        p.error("--live needs --target <id> (see action=targets)")
+    r = Run()
+    print(f"run {r.run}", flush=True)
+    safe(r)
+    if a.live:
+        live(r, a.target)
+    failed = [n for n, ok, _ in r.results if not ok]
+    print(f"\n{len(r.results) - len(failed)} passed, {len(failed)} failed")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
