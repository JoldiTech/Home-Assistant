# systemd --user unit for Duologue. Install:
#   mkdir -p ~/.config/systemd/user
#   cp duologue.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now duologue
#
# Localhost-bound and CPU-only. Reach it over an SSH tunnel:
#   ssh -L 8477:127.0.0.1:8477 aibox   # then http://localhost:8477
[Unit]
Description=Duologue — multi-persona chat orchestrator (local llama.cpp)
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=
Environment=DUOLOGUE_HOST=127.0.0.1
Environment=DUOLOGUE_PORT=8477
WorkingDirectory=%h/duologue
ExecStart=%h/imagegen-env/bin/python %h/duologue/duologue.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
